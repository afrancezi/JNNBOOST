pipeline {
    agent any

    // Caminho REAL no host (e, graças ao bind mount, também visível
    // dentro do container do Jenkins no mesmo caminho). É essa pasta
    // que tem o .env de verdade - por isso operamos nela diretamente,
    // em vez de deixar o Jenkins clonar uma cópia isolada e sem segredos.
    environment {
        DEPLOY_DIR = '/home/afrancezi/JNNBOOST'
    }

    stages {
        stage('Atualizar código') {
            steps {
                sh '''
                    cd "$DEPLOY_DIR"
                    git fetch origin
                    git reset --hard origin/main
                '''
            }
        }

        stage('Build & Deploy API') {
            steps {
                sh '''
                    cd "$DEPLOY_DIR/JnnBoost.Api"
                    docker compose up -d --build
                '''
            }
        }

        stage('Verificar saúde da API') {
            steps {
                sh 'sleep 10'
                // -k aceita o certificado auto-assinado do Caddy (rede local,
                // sem domínio ainda). Remova o -k quando migrar para
                // certificado Let's Encrypt de verdade em produção.
                sh 'curl -k -f https://localhost/api/health || exit 1'
            }
        }
    }

    post {
        success {
            echo 'Deploy da API concluído com sucesso.'
        }
        failure {
            echo 'Falha no deploy da API - verifique os logs acima.'
        }
    }
}

