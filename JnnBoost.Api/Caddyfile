# Caddyfile de produção
#
# Diferenças em relação ao Caddyfile local (rede/VM):
#   - Usa o domínio real + Let's Encrypt (certificado confiável de
#     verdade), no lugar do certificado auto-assinado ("tls internal").
#   - Só expõe publicamente os endpoints que o APP PRECISA alcançar
#     (/api/validar e /api/health). Os endpoints administrativos
#     (/api/admin/*) NUNCA ficam acessíveis pela internet - o bot do
#     Discord fala com a API direto pela rede interna do Docker,
#     nunca precisa passar por aqui.

{
	email {$CADDY_EMAIL}
}

{$DOMAIN} {
	handle /api/validar {
		reverse_proxy jnnboost-api:8080
	}

	handle /api/health {
		reverse_proxy jnnboost-api:8080
	}

	# Qualquer outra rota (incluindo /api/admin/*) cai aqui e recebe 404,
	# como se nem existisse - inclusive para quem tentar adivinhar o
	# caminho.
	handle {
		respond "Not found" 404
	}
}
